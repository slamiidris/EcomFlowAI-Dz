# GEMINI_API_KEY: Required for Gemini AI API calls. Server-side only — never
# exposed to the browser (the client talks to POST /api/ai/generate).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DATABASE_URL: PostgreSQL connection string (Neon, Supabase, or local).
# Get from your database dashboard. Used by Prisma for all data persistence.
DATABASE_URL="postgresql://user:password@ep-xxx-xxx.region.aws.neon.tech/dbname?sslmode=require"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google-only login. Both are REQUIRED for real Google OAuth; when they are
# missing, the login button runs a clearly-labeled DEV MOCK instead (testable).
# Create credentials at https://console.cloud.google.com/apis/credentials
# and set the OAuth redirect URI to {APP_URL}/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SESSION_SECRET: signs the login cookie. Must be a long random string.
# In development it falls back to a dev default; in production it is required.
SESSION_SECRET=

# Manual payment confirmation: where the buyer sends the facture proof, and the
# token the admin uses to confirm a plan (POST /api/admin/confirm-plan).
ADMIN_EMAIL="admin@dzads.ai"
ADMIN_TELEGRAM="DzAdsAdmin"
ADMIN_TOKEN=

# Real Telegram product scouting (MTProto). All three are REQUIRED for live reads;
# without them /api/telegram-trends returns a clearly-labeled simulation.
# - TELEGRAM_API_ID / TELEGRAM_API_HASH: your MTProto app credentials (my.telegram.org)
# - TELEGRAM_SESSION: a StringSession string from a previously authorized account
#   (generate it once via a local script using the `telegram` package).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
