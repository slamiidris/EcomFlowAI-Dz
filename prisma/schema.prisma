generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model api_settings {
  id                         String   @id
  user_id                    String   @unique
  facebook_ads_token         String?
  facebook_account_id        String?
  tiktok_ads_token           String?
  tiktok_account_id          String?
  google_ads_customer_id     String?
  google_ads_developer_token String?
  snap_ads_token             String?
  snap_account_id            String?
  gemini_api_key             String?
  workspace_name             String   @default("E-com DZ Workspace")
  custom_api_token           String?
  updated_at                 DateTime
  users                      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model chat_sessions {
  id         String   @id
  user_id    String
  title      String?
  messages   Json     @default("[]")
  updated_at DateTime
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model generation_history {
  id           String   @id
  user_id      String
  type         String
  title        String
  preview_text String?
  payload      Json
  metadata     Json?
  created_at   DateTime @default(now())
  users        users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at(sort: Desc)])
}

model lp_sessions {
  id         String   @id
  user_id    String
  title      String?
  state      Json
  updated_at DateTime
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model product_catalog {
  id             String   @id
  user_id        String
  name           String
  category       String
  purchase_price Decimal? @db.Decimal(12, 2)
  selling_price  Decimal? @db.Decimal(12, 2)
  target_cpa     Decimal? @db.Decimal(8, 2)
  stock          Int      @default(0)
  status         String?
  image_url      String?
  countries      String   @default("DZ")
  description    String?
  sales          Int      @default(0)
  euro_rate      Decimal  @default(220) @db.Decimal(8, 2)
  conf_rate      Decimal  @default(0.80) @db.Decimal(5, 4)
  deliv_rate     Decimal  @default(0.60) @db.Decimal(5, 4)
  created_at     DateTime @default(now())
  updated_at     DateTime
  users          users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model user_preferences {
  id                     String   @id
  user_id                String   @unique
  tools_order            String[] @default([])
  dashboard_config       Json     @default("{}")
  dashboard_widget_order String[] @default(["featured", "stats", "geo", "prediction", "history"])
  language               String   @default("fr")
  theme                  String   @default("dark")
  last_image             Json?
  last_script            Json?
  last_lp_active_id      String?
  last_chat_active_id    String?
  updated_at             DateTime
  users                  users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model users {
  id                 String               @id
  email              String               @unique
  name               String
  avatar_url         String?
  plan               String?
  plan_status        String?
  plan_selected_at   DateTime?
  plan_active_from   DateTime?
  plan_expires_at    DateTime?
  created_at         DateTime             @default(now())
  updated_at         DateTime
  api_settings       api_settings?
  chat_sessions      chat_sessions[]
  generation_history generation_history[]
  lp_sessions        lp_sessions[]
  product_catalog    product_catalog[]
  user_preferences   user_preferences?
}
