generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ApiSettings {
  id                      String   @id @default(uuid())
  userId                  String   @unique @map("user_id")
  facebookAdsToken        String?  @map("facebook_ads_token")
  facebookAccountId       String?  @map("facebook_account_id")
  tiktokAdsToken          String?  @map("tiktok_ads_token")
  tiktokAccountId         String?  @map("tiktok_account_id")
  googleAdsCustomerId     String?  @map("google_ads_customer_id")
  googleAdsDeveloperToken String?  @map("google_ads_developer_token")
  snapAdsToken            String?  @map("snap_ads_token")
  snapAccountId           String?  @map("snap_account_id")
  geminiApiKey            String?  @map("gemini_api_key")
  workspaceName           String   @default("E-com DZ Workspace") @map("workspace_name")
  customApiToken          String?  @map("custom_api_token")
  updatedAt               DateTime @updatedAt @map("updated_at")
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_settings")
}

model EmailOtp {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  codeHash  String   @map("code_hash")
  reason    String   @default("verification")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  attempts  Int      @default(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("email_otps")
}

model ChatSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String?
  messages  Json     @default("[]")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_sessions")
}

model GenerationHistory {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  type        String
  title       String
  previewText String?  @map("preview_text")
  payload     Json
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("generation_history")
}

model LpSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String?
  state     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("lp_sessions")
}

model ProductCatalog {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  name          String
  category      String
  purchasePrice Decimal? @map("purchase_price") @db.Decimal(12, 2)
  sellingPrice  Decimal? @map("selling_price") @db.Decimal(12, 2)
  targetCpa     Decimal? @map("target_cpa") @db.Decimal(8, 2)
  stock         Int      @default(0)
  status        String?
  imageUrl      String?  @map("image_url")
  countries     String   @default("DZ")
  description   String?
  sales         Int      @default(0)
  euroRate      Decimal  @default(220) @map("euro_rate") @db.Decimal(8, 2)
  confRate      Decimal  @default(0.80) @map("conf_rate") @db.Decimal(5, 4)
  delivRate     Decimal  @default(0.60) @map("deliv_rate") @db.Decimal(5, 4)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("product_catalog")
}

model UserPreferences {
  id                   String   @id @default(uuid())
  userId               String   @unique @map("user_id")
  toolsOrder           String[] @default([]) @map("tools_order")
  dashboardConfig      Json     @default("{}") @map("dashboard_config")
  dashboardWidgetOrder String[] @default(["featured", "stats", "geo", "prediction", "history"]) @map("dashboard_widget_order")
  language             String   @default("fr")
  theme                String   @default("dark")
  lastImage            Json?    @map("last_image")
  lastScript           Json?    @map("last_script")
  lastLpActiveId       String?  @map("last_lp_active_id")
  lastChatActiveId     String?  @map("last_chat_active_id")
  updatedAt            DateTime @updatedAt @map("updated_at")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  name               String
  avatarUrl          String?             @map("avatar_url")
  plan               String?
  planStatus         String?             @map("plan_status")
  planSelectedAt     DateTime?           @map("plan_selected_at")
  planActiveFrom     DateTime?           @map("plan_active_from")
  planExpiresAt      DateTime?           @map("plan_expires_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  emailVerifiedAt    DateTime?           @map("email_verified_at")
  passwordHash       String?             @map("password_hash")
  isAdmin            Boolean             @default(false) @map("is_admin")
  paymentMethod      String?             @map("payment_method")
  paymentNote        String?             @map("payment_note")
  paymentProof       String?             @map("payment_proof")
  paymentSubmittedAt DateTime?           @map("payment_submitted_at")
  planDays           Int?                @map("plan_days")
  apiSettings        ApiSettings?
  chatSessions       ChatSession[]
  emailOtps          EmailOtp[]
  generationHistory  GenerationHistory[]
  lpSessions         LpSession[]
  productCatalog     ProductCatalog[]
  userPreferences    UserPreferences?

  @@map("users")
}

model PaymentMethod {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  description  String?
  emoji        String   @default("💳")
  type         String   @default("manual")
  instructions Json     @default("[]")
  details      Json?
  enabled      Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([enabled, sortOrder])
  @@map("payment_methods")
}

model Announcement {
  id        String    @id @default(uuid())
  title     String
  message   String
  emoji     String    @default("📢")
  kind      String    @default("info")
  active    Boolean   @default(true)
  startsAt  DateTime? @map("starts_at")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([active, startsAt, expiresAt])
  @@map("announcements")
}

model HotDeal {
  id          String   @id @default(uuid())
  title       String
  description String?
  emoji       String   @default("🔥")
  badge       String?
  price       String?
  link        String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([active, sortOrder])
  @@map("hot_deals")
}

model PlatformConfig {
  id               String   @id @default("singleton")
  currencyCode     String   @default("DA")
  currencySymbol   String   @default("DA")
  currencyPosition String   @default("after")
  monthlyPrice     Int      @default(1500)
  quarterlyPrice   Int      @default(3500)
  lifetimePrice    Int      @default(15000)
  updatedAt        DateTime @updatedAt @map("updated_at")
  adminEmail       String   @default("")
  adminTelegram    String   @default("")
  whatsappNumber   String   @default("")

  @@map("platform_config")
}

model Guide {
  id          String   @id @default(uuid())
  title       String
  youtubeUrl  String   @map("youtube_url")
  description String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([active, sortOrder])
  @@map("guides")
}
